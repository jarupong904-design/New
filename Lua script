-- ==========================================
-- 🛠️ ระบบลากวาง GUI (Smooth Draggable Script)
-- ==========================================
local dragging, dragInput, dragStart, startPos

local function update(input)
 local delta = input.Position - dragStart
 MainContainer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

ClockFrame.InputBegan:Connect(function(input)
 if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
  dragging = true
  dragStart = input.Position
  startPos = MainContainer.Position
  
  input.Changed:Connect(function()
   if input.UserInputState == Enum.UserInputState.End then
    dragging = false
   end
  end)
 end
end)

ClockFrame.InputChanged:Connect(function(input)
 if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
  dragInput = input
 end
end)

UserInputService.InputChanged:Connect(function(input)
 if input == dragInput and dragging then
  update(input)
 end
end)
-- ==========================================

-- 2. ระบบคำนวณการเดินของเข็มนาฬิกา
local TimeIsStopped = false
local FakeTime = 0

RunService.RenderStepped:Connect(function(dt)
 if not TimeIsStopped then
  FakeTime = FakeTime + dt * 20
  MinuteHand.Rotation = FakeTime * 6
  HourHand.Rotation = FakeTime * 0.5
 end
end)

-- 3. ระบบควบคุมการหยุดเวลาและการคืนค่าปกติ
local SavedStates = {}

local function ToggleTimeStop()
 if TimeIsStopped then
  -- >>> ปลดปล่อยเวลา (UN-TIMESTOP) <<<
  TimeIsStopped = false
  TriggerButton.Text = "STOP TIME"
  TriggerButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
  
  local Sound = Instance.new("Sound", workspace)
  Sound.SoundId = "rbxassetid://9114227092" 
  Sound.Volume = 1
  Sound:Play()
  game:GetService("Debris"):AddItem(Sound, 2)
  
  local CC = Lighting:FindFirstChild("TimeStopCC")
  if CC then CC:Destroy() end
  
  for _, data in ipairs(SavedStates) do
   if data.Instance and data.Instance.Parent then
    if data.Instance:IsA("BasePart") then
     data.Instance.Anchored = data.Anchored
     data.Instance.AssemblyLinearVelocity = data.Velocity
     data.Instance.AssemblyAngularVelocity = data.AngularVelocity
    elseif data.Instance:IsA("Humanoid") then
     data.Instance.WalkSpeed = data.WalkSpeed
     data.Instance.JumpPower = data.JumpPower
    end
   end
  end
  table.clear(SavedStates)
 else
  -- >>> แช่แข็งเวลา (TIMESTOP) <<<
  TimeIsStopped = true
  TriggerButton.Text = "RESUME"
  TriggerButton.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
  
  local CC = Instance.new("ColorCorrectionEffect", Lighting)
  CC.Name = "TimeStopCC"
  CC.Saturation = -0.8
  CC.Contrast = 0.2
  CC.Enabled = true
  
  local Sound = Instance.new("Sound", workspace)
  Sound.SoundId = "rbxassetid://130113524"
  Sound.Volume = 1
  Sound:Play()
  game:GetService("Debris"):AddItem(Sound, 2)
  
  task.spawn(function()
   for i = 1, 10 do
    MinuteHand.Rotation = MinuteHand.Rotation + math.random(-4, 4)
    task.wait(0.01)
   end
  end)

  for _, obj in ipairs(workspace:GetDescendants()) do
   if obj:IsA("BasePart") and not obj:IsDescendantOf(Character) and not obj.Anchored then
    table.insert(SavedStates, {
     Instance = obj,
     Anchored = obj.Anchored,
     Velocity = obj.AssemblyLinearVelocity,
     AngularVelocity = obj.AssemblyAngularVelocity
    })
    obj.AssemblyLinearVelocity = Vector3.new(0,0,0)
    obj.AssemblyAngularVelocity = Vector3.new(0,0,0)
    obj.Anchored = true
   elseif obj:IsA("Humanoid") and not obj:IsDescendantOf(Character) then
    table.insert(SavedStates, {
     Instance = obj,
     WalkSpeed = obj.WalkSpeed,
     JumpPower = obj.JumpPower
    })
    obj.WalkSpeed = 0
    obj.JumpPower = 0
   end
  end
 end
end

TriggerButton.MouseButton1Click:Connect(ToggleTimeStop)
print("⏰ [Draggable Time Stop] รันระบบสำเร็จ! คุณสามารถคลิกค้างที่ตัวนาฬิกาเพื่อลากขยับตำแหน่งได้แล้วครับ")
